APP_NAME=TheraPlay
APP_ENV=local
# Generate with: php artisan key:generate (never commit a real key)
APP_KEY=
# Keep false for anything public: true shows stack traces and file paths in errors.
# Set it to true only on your own machine while developing.
APP_DEBUG=false
APP_URL=http://localhost:8000

# Address of the React frontend (used in password-reset links) and the origins
# allowed to call the API from a browser (comma separated).
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minutes an API login token stays valid (default 10080 = 7 days; 0 = never expire).
SANCTUM_TOKEN_EXPIRATION=10080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# TheraPlay is developed against MySQL/MariaDB. Create an empty database first and
# put your own values below (placeholders only: never commit real credentials).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=theraplay_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Email (verification links, password reset links)
#
# LOCAL DEVELOPMENT: keep MAIL_MAILER=log. Nothing is delivered; each email,
# including its link, is written to storage/logs/laravel.log. The app is honest
# about this: it says "email delivery is not set up" instead of "email sent".
#
# REAL DELIVERY: set MAIL_MAILER=smtp and fill in the values your mail provider
# gives you. Never commit real credentials: they belong only in your own .env.
# After changing .env, restart the server (php artisan config:clear if cached).
#
#   Generic SMTP service (Mailgun, Brevo, SES SMTP, your host's mail server, ...):
#     MAIL_MAILER=smtp
#     MAIL_HOST=<the SMTP host from your provider>
#     MAIL_PORT=587                  # 587 = STARTTLS (usual), 465 = SSL/TLS
#     MAIL_SCHEME=null               # use smtps with port 465
#     MAIL_USERNAME=<provider username>
#     MAIL_PASSWORD=<provider password or API key>
#     MAIL_FROM_ADDRESS="<an address your provider lets you send from>"
#
#   Gmail SMTP (fine for testing; Google limits how many emails you can send):
#     MAIL_MAILER=smtp
#     MAIL_HOST=smtp.gmail.com
#     MAIL_PORT=587
#     MAIL_SCHEME=null
#     MAIL_USERNAME=<your full Gmail address>
#     MAIL_PASSWORD=<a Google "App password">   (NOT your normal password: turn on
#                                                2-Step Verification, then create
#                                                an App password in your Google
#                                                account security settings)
#     MAIL_FROM_ADDRESS="<the same Gmail address>"
#
# Test it safely: php artisan tinker, then
#   Mail::raw('Test', fn ($m) => $m->to('your-own-address@example.com')->subject('Test'));
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email verification links stay valid for this many minutes.
EMAIL_VERIFICATION_EXPIRE=60
# Accounts CREATED AT OR AFTER this date/time must verify their email address
# before using the app. Accounts created earlier are never locked out. Leave it
# empty until real email delivery (above) works, otherwise new people could never
# receive their link. Example: EMAIL_VERIFICATION_ENFORCED_FROM="2026-12-01 00:00:00"
EMAIL_VERIFICATION_ENFORCED_FROM=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
