# TheraPlay frontend (Vite) configuration. Copy to .env and adjust; .env is not
# committed. Only variables starting with VITE_ reach the browser, so never put
# secrets here.

# Base URL of the Laravel API, including /api (no trailing slash needed).
# Local development (php artisan serve):
VITE_API_URL=http://127.0.0.1:8000/api
# For a deployment, set it to your real API address, for example:
# VITE_API_URL=https://api.your-domain.example/api
